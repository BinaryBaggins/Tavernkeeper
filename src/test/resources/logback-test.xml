<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <appender name="CONSOLE"
        class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Suppress intentionally generated command failures -->
    <logger
        name="io.github.binarybaggins.tavernkeeper.discord.commands.CommandListener"
        level="OFF" />
    <logger
        name="io.github.binarybaggins.tavernkeeper.features.guilds.discord.GuildRegistrationListener"
        level="OFF" />

    <root level="WARN">
        <appender-ref ref="CONSOLE" />
    </root>

</configuration>